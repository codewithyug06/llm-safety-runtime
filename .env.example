# ==============================================================================
# ARGUS Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# Note: Sensitive keys should never be committed to source control.
# ==============================================================================

# --- Core Service Connections ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0
MLFLOW_TRACKING_URI=http://localhost:5000
SAFETY_CRITIC_ENDPOINT=http://localhost:8001

# --- API Security & Authentication ---
ARGUS_API_KEYS=dev-test-key-1,dev-test-key-2
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=argus_secure_password_change_me

# --- LLM Providers & Model Registries ---
ANTHROPIC_API_KEY=sk-ant-api03-...
HF_TOKEN=hf_...
WANDB_API_KEY=

# --- Cloud Infrastructure (GCP / Kubernetes) ---
GCP_PROJECT_ID=my-argus-gcp-project
GKE_CLUSTER_NAME=argus-prod-cluster
SPANNER_INSTANCE_ID=argus-audit-instance
SPANNER_DATABASE_ID=argus-audit-db

# --- Optional Alerting Integrations ---
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
